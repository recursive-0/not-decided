{
  "name": "echo-ai",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun run dev:web && bun run dev:worker",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "i:web": "--cwd apps/web"
  },
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "groq-sdk": "^0.21.0"
  }
}