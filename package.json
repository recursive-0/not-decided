{
  "name": "echo-ai",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:web && pnpm run dev:worker",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:worker": "pnpm --filter ./apps/worker dev",
    "build": "pnpm run build:web",
    "build:web": "pnpm --filter ./apps/web build",
    "i:web": "pnpm --filter ./apps/web",
    "i:worker": "pnpm --filter ./apps/worker"
  },
  "dependencies": {
    "groq-sdk": "^0.21.0"
  }
}