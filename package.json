{
  "name": "monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel --filter monorepo/web --filter monorepo/worker dev",
    "web": "pnpm --filter monorepo/web",
    "worker": "pnpm --filter monorepo/worker",
    "build": "pnpm run --parallel --filter monorepo/web --filter monorepo/worker build",
    "build:web": "pnpm --filter monorepo/web build",
    "build:worker": "pnpm --filter monorepo/worker build"
  },
  "dependencies": {
    "groq-sdk": "^0.21.0"
  }
}