{
  "name": "echo-ai",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun run dev:worker && bun run dev:web",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bunx run --cwd apps/worker dev",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "i:web": "bun --cwd apps/web add"
  },
  "type": "module",
  "workspaces": ["apps/*", "packages/*"]
}