{
	"name": "monorepo/worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"generate": "drizzle-kit generate",
		"migrate:dev": "wrangler d1 migrations apply DB_DEV --local",
		"migrate:prod": "wrangler d1 migrations apply DB_DEV --remote",
		"db:drop": "drizzle-kit drop",
		"db:reset": "pnpm run db:drop && pnpm run generate && pnpm run migrate:dev",
		"db:setup": "pnpm run generate && pnpm run migrate:dev",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.19",
		"@cloudflare/workers-types": "^4.20250427.0",
		"@types/node": "^22.15.2",
		"typescript": "^5.5.2",
		"vitest": "~3.0.7",
		"wrangler": "^4.13.2"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.40.1",
		"@google/genai": "^0.10.0",
		"@google/generative-ai": "^0.24.0",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.31.1",
		"drizzle-orm": "^0.43.1",
		"openai": "^4.96.0",
		"zod": "^3.24.3"
	}
}
